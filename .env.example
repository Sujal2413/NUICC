# Contact form delivery (https://resend.com). Without a key, the form returns a
# friendly error directing visitors to email info@nuicc.org directly.
RESEND_API_KEY=
# Address the contact form delivers to.
CONTACT_TO_EMAIL=info@nuicc.org
# Verified sender address for Resend ("onboarding@resend.dev" works for testing).
CONTACT_FROM_EMAIL=onboarding@resend.dev
